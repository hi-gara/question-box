---
import { getCollection } from "astro:content";

const siteName = "hi_garaの質問箱";
const formUrl = "https://forms.gle/frujUr96N8YMgu8t8";

const replies = (await getCollection("questions"))
	.filter((reply) => reply.data.published)
	.sort(
		(a, b) =>
			b.data.date.getTime() - a.data.date.getTime(),
	);
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Googleフォームから届いた質問に、ひとつずつお返事しています。"
		/>
		<title>{siteName}</title>
	</head>

	<body>
		<header class="header">
			<div class="header-inner">
				<a class="logo" href="/">{siteName}</a>

				<a
	class="header-link"
	href={formUrl}
	target="_blank"
	rel="noopener noreferrer"
>
	質問する ↗
</a>
			</div>
		</header>

		<main>
			<section class="hero">
				<p class="eyebrow">QUESTION & ANSWER</p>

				<h1>{siteName}</h1>

				<p class="description">
					Googleフォームから届いた質問に、ひとつずつお返事しています。
				</p>

				<a
	class="form-button"
	href={formUrl}
	target="_blank"
	rel="noopener noreferrer"
>
	質問を送る
	<span aria-hidden="true">↗</span>
</a>
			</section>

			<section class="replies">
				<div class="section-heading">
					<div>
						<p class="section-label">LATEST REPLIES</p>
						<h2>最近の返信</h2>
					</div>

					<a class="view-all" href="#">すべて見る →</a>
				</div>

				<div class="reply-list">
					{
	replies.map((reply) => (
		<a class="reply-card" href={`/questions/${reply.id}/`}>
			<div>
				<p class="question-mark">Q.</p>
				<h3>{reply.data.title}</h3>
			</div>

			<div class="card-footer">
				<time>
					{reply.data.date.toLocaleDateString("ja-JP")}
				</time>
				<span class="arrow" aria-hidden="true">→</span>
			</div>
		</a>
	))
}
				</div>
			</section>
		</main>

		<footer>
			<p>© 2026 {siteName}</p>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: #f2f3f4;
		color: #27292c;
		font-family:
			"Yu Gothic UI",
			"Yu Gothic",
			"BIZ UDPGothic",
			"Meiryo",
			sans-serif;
	}

	:global(body) {
		margin: 0;
		min-width: 320px;
		background:
			linear-gradient(
				180deg,
				#f7f8f8 0,
				#f2f3f4 480px,
				#f2f3f4 100%
			);
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	.header {
		border-bottom: 1px solid #dfe1e3;
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100% - 40px, 1040px);
		height: 72px;
		margin: 0 auto;
	}

	.logo {
		font-size: 16px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.header-link {
		color: #666a70;
		font-size: 14px;
		font-weight: 600;
	}

	main {
		width: min(100% - 40px, 880px);
		margin: 0 auto;
	}

	.hero {
		padding: 108px 0 96px;
		text-align: center;
	}

	.eyebrow,
	.section-label {
		margin: 0 0 14px;
		color: #7b7f85;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.22em;
	}

	h1 {
		margin: 0;
		font-size: clamp(38px, 8vw, 64px);
		line-height: 1.15;
		letter-spacing: 0.04em;
	}

	.description {
		margin: 28px 0 0;
		color: #686c72;
		font-size: 15px;
		line-height: 2;
	}

	.form-button {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 40px;
		min-width: 190px;
		margin-top: 36px;
		padding: 15px 20px;
		border: 1px solid #303236;
		background: #303236;
		color: #fff;
		font-size: 14px;
		font-weight: 700;
		transition:
			transform 160ms ease,
			background-color 160ms ease;
	}

	.form-button:hover {
		transform: translateY(-2px);
		background: #45484d;
	}

	.replies {
		padding: 68px 0 112px;
		border-top: 1px solid #dfe1e3;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 28px;
	}

	h2 {
		margin: 0;
		font-size: 28px;
		letter-spacing: 0.04em;
	}

	.view-all {
		padding-bottom: 3px;
		color: #696d73;
		font-size: 13px;
		font-weight: 600;
	}

	.reply-list {
		display: grid;
		gap: 16px;
	}

	.reply-card {
		display: flex;
		min-height: 180px;
		flex-direction: column;
		justify-content: space-between;
		padding: 28px;
		border: 1px solid #dfe1e3;
		background: #fafafa;
		box-shadow: 0 3px 16px rgb(40 42 45 / 4%);
		transition:
			transform 160ms ease,
			border-color 160ms ease,
			box-shadow 160ms ease;
	}

	.reply-card:hover {
		transform: translateY(-3px);
		border-color: #c5c8cc;
		box-shadow: 0 8px 24px rgb(40 42 45 / 8%);
	}

	.question-mark {
		margin: 0 0 14px;
		color: #777b81;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	h3 {
		margin: 0;
		font-size: 19px;
		line-height: 1.7;
		letter-spacing: 0.02em;
	}

	.card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: 30px;
		color: #777b81;
		font-size: 12px;
	}

	.arrow {
		font-size: 18px;
		transition: transform 160ms ease;
	}

	.reply-card:hover .arrow {
		transform: translateX(4px);
	}

	footer {
		padding: 32px 20px;
		border-top: 1px solid #dfe1e3;
		color: #85898f;
		font-size: 11px;
		letter-spacing: 0.08em;
		text-align: center;
	}

	@media (max-width: 600px) {
		.header-inner,
		main {
			width: min(100% - 32px, 880px);
		}

		.hero {
			padding: 80px 0 72px;
		}

		.description br {
			display: none;
		}

		.replies {
			padding: 52px 0 80px;
		}

		.section-heading {
			align-items: start;
		}

		.reply-card {
			min-height: 160px;
			padding: 24px;
		}
	}
</style>